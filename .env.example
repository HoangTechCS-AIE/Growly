# Growly configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the template.
# Next.js loads `.env` automatically; the node scripts under `scripts/` read it
# through `--env-file-if-exists`, so one file covers both.
#
# Values set in Settings → AI provider are stored in the database and take
# precedence over the OPENAI_* entries below, which act as the defaults.

# ---------------------------------------------------------------- database
# Where the SQLite file lives, and where the crawled fanpage archive sits.
GROWLY_DB=data/growly.db
GROWLY_CORPUS=data

# ------------------------------------------------------- fanpage crawl
# Used by `npm run crawl:posts` to pull the page archive into data/<id>/post.json.
# Page ID is on the fanpage's About tab; the token is a Page access token from
# developers.facebook.com/tools/explorer with pages_read_engagement +
# pages_read_user_content. Short-lived tokens expire in about an hour — extend
# one before a full crawl. Leave both blank if the archive is copied in by hand.
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_API_VERSION=v21.0

# ------------------------------------------------------------- AI provider
# Any endpoint that answers POST /chat/completions. `/chat/completions` is
# appended automatically if the URL stops at the version prefix.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Writing temperature. 0.9 keeps the teen voice natural; lower reads flat.
OPENAI_TEMPERATURE=0.9
# Reading a document is copying, not composing — keep this at 0.
OPENAI_EXTRACT_TEMPERATURE=0

# -------------------------------------------------- club identity (footer)
# Used to build the post footer and to let the linter recognise it.
# Tên đầy đủ, đúng như nó xuất hiện ở dòng đầu footer.
#   ví dụ: CÂU LẠC BỘ TIN HỌC ABC - Đại học X
CLUB_NAME=
#   ví dụ: CLB Tin học ABC
CLUB_SHORT=
CLUB_FOUNDED=
CLUB_FANPAGE=
CLUB_WEBSITE=
CLUB_EMAIL=
# Also editable in Settings, which overrides the value here.
CLUB_ADDRESS=
# What the page calls its members, e.g. "HITers". Offered as an option under
# "Gọi người đọc"; leave blank if the club has no such word.
CLUB_MEMBER_TERM=

# Hashtags appended to every post, space separated.
# Quoted: an unquoted value starting with "#" is read as a comment.
CLUB_HASHTAGS=""
# What the linter searches for to confirm the footer is present. Leave empty to
# use the part of CLUB_NAME before " - ".
CLUB_FOOTER_MARKER=

# ------------------------------------------------------------------ limits
# How much of an uploaded .docx/.pdf is read.
CONTENT_DOC_MAX_CHARS=20000
# Give up on the provider after this many milliseconds.
CONTENT_REQUEST_TIMEOUT_MS=120000
# How many real posts are shown to the model as few-shot examples, and how far
# back to draw them from. The page reformatted in 2024, so older posts teach the
# wrong shape.
CONTENT_FEWSHOT_COUNT=3
CONTENT_FEWSHOT_SINCE=2024-01-01
# Upload cap for the server action that receives the document.
CONTENT_UPLOAD_LIMIT=12mb
