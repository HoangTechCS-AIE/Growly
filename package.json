{
  "name": "growly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.mjs",
    "test:flows": "tsc -p tsconfig.smoke.json && node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/smoke-test.cjs",
    "crawl:posts": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/crawl-posts.mjs",
    "import:posts": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/import-posts.mjs",
    "lint:corpus": "tsc -p tsconfig.smoke.json && node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/lint-corpus.cjs",
    "test:content": "tsc -p tsconfig.smoke.json && node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/test-generate.cjs",
    "test:document": "tsc -p tsconfig.smoke.json && node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/test-document.cjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.5"
  }
}
